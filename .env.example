# ============================================================================
# ARISE — Environment Template
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# All values are read via `process.env.EXPO_PUBLIC_*` (inlined at build time).
# ============================================================================

# --- Firebase (Web / JS SDK configuration) ----------------------------------
# Found in Firebase Console → Project settings → General → "Your apps" → Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Sign-In ---------------------------------------------------------
# OAuth 2.0 Web Client ID from Google Cloud Console (required by google-signin).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- ReactVision Platform (OPTIONAL — cloud anchors / geospatial only) ------
# Not required for basic AR portals. Leave empty to use on-device AR only.
GOOGLE_CLOUD_API_KEY=
RV_API_KEY=
RV_PROJECT_ID=
